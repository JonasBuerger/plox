# EditorConfig: https://editorconfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Indentation override for JS and config files
[*.{{cj,mj,j,t}s,json,xml,yml,yaml,neon}]
indent_size = 2

[*.bat]
end_of_line = crlf
