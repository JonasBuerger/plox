#!/usr/bin/env php
<?php

require_once dirname(__DIR__) . '/bootstrap.php';

return static function (array $args, string $projectDir) {
    if (count($args) > 1) {
        echo 'Usage: bin/run [filename]', PHP_EOL;
        return \Plox\ExitCode::EX_USAGE->value;
    } else if ($args === []) {
        return \Plox\Interpreter::runPrompt();
    } else if (!file_exists($args[0])) {
        printf('File "%s" not found.', $args[0]);
        return \Plox\ExitCode::EX_NOINPUT->value;
    } else {
        return \Plox\Interpreter::runFile($args[0]);
    }
};
