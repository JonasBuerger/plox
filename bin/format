#!/usr/bin/env php
<?php

require_once dirname(__DIR__) . '/bootstrap.php';

return static function (array $args, string $projectDir): int {
    $quiet = false;
    if (in_array('--quiet', $args)) {
        $quiet = true;
    }
    if (!is_executable($projectDir . '/vendor/bin/php-cs-fixer') || !is_executable($projectDir . '/vendor/bin/rector')) {
        echo 'rector or php-cs-fixer are missing, run: composer install', PHP_EOL;
        return \Plox\ExitCode::EX_USAGE->value;
    }
    if ($quiet) {
        exec($projectDir . '/vendor/bin/php-cs-fixer fix --quiet', result_code: $exitCode);
        if ($exitCode !== \Plox\ExitCode::SUCCESS->value) {
            return $exitCode;
        }
        exec($projectDir . '/vendor/bin/rector --no-progress-bar', result_code: $exitCode);
    } else {
        passthru($projectDir . '/vendor/bin/php-cs-fixer fix' . ($quiet ? ' --quiet' : ''), $exitCode);
        if ($exitCode !== \Plox\ExitCode::SUCCESS->value) {
            return $exitCode;
        }
        passthru($projectDir . '/vendor/bin/rector' . ($quiet ? ' --no-progress-bar' : ''), $exitCode);
    }
    return $exitCode;
};
