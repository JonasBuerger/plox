// For Loop Fibonacci
var start = clock();
var a = 0;
var temp;

for (var b = 1; a < 1000; b = temp + b) {
  print a;
  temp = a;
  a = b;
}

print "Finished after ";
print clock() - start;
print "seconds";

// User defined Function Call
fun sayHi(first, last) {
  print "Hi, " + first + " " + last + "!";
}

sayHi("Dear", "Reader");

// Recursive Fibonacci
fun fib(n) {
  if (n <= 1) return n;
  return fib(n - 2) + fib(n - 1);
}

start = clock();
for (var i = 0; i <= 16; i = i + 1) {
  print fib(i);
}
print "Finished after ";
print clock() - start;
print "seconds";

// Nested Function/Closure
fun makeCounter() {
  var i = 0;
  fun count() {
    i = i + 1;
    print i;
  }

  return count;
}

var counter = makeCounter();
counter(); // "1".
counter(); // "2".
